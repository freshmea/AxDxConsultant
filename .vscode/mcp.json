{
  "inputs": [
    {
      "type": "promptString",
      "id": "n8n-mcp-token",
      "description": "n8n MCP Access Token",
      "password": true
    }
  ],
  "servers": {
    "n8n": {
      "type": "http",
      "url": "https://freshmea.app.n8n.cloud/mcp-server/http",
      "headers": {
        "Authorization": "Bearer ${input:n8n-mcp-token}"
      }
    },
    "kordoc": {
      "type": "stdio",
      "command": "cmd",
      "args": ["/c", "npx", "-y", "kordoc@latest", "mcp"]
    },
    "firecrawl-mcp": {
      "command": "npx",
      "args": [
        "-y",
        "firecrawl-mcp"
      ],
      "env": {
        "FIRECRAWL_API_KEY": "fc-4f979166e3184fdbb5309fc94aa890a0"
      }
    }
  }
}
